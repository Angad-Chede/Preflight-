{
  "name": "preflight-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,web\" -c \"blue,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed --workspace=server --if-present",
    "live:smoke": "npm run live:smoke --workspace=@preflight/server",
    "demo": "bash scripts/curl-demo.sh",
    "e2e": "npm run e2e --workspace=@preflight/server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
